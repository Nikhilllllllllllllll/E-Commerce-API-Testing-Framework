  "item": [
    {
      "name": "Get All Products",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Response time is under 5 seconds\", function () {\r",
              "    pm.expect(pm.response.responseTime).to.be.below(5000);\r",
              "});\r",
              "pm.test(\"Response is a non-empty array\", function () {\r",
              "    const products = pm.response.json();\r",
              "\r",
              "    pm.expect(products).to.be.an(\"array\");\r",
              "    pm.expect(products.length).to.be.above(0);\r",
              "});\r",
              "\r",
              "pm.test(\"Each product has required fields\", function () {\r",
              "    const products = pm.response.json();\r",
              "\r",
              "    products.forEach(function (product) {\r",
              "        pm.expect(product).to.have.property(\"id\");\r",
              "        pm.expect(product).to.have.property(\"title\");\r",
              "        pm.expect(product).to.have.property(\"price\");\r",
              "    });\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/products",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "products"
          ]
        }
      },
      "response": []
    },
